CAD_STORAGE_ROOT=/data/storage
DATABASE_URL=postgresql+psycopg://cadpilot:cadpilot@postgres:5432/cadpilot
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
MCP_SERVER_COMMAND=uvx
MCP_SERVER_ARGS=freecad-mcp --only-text-feedback --freecadcmd /usr/local/bin/freecadcmd
MCP_TIMEOUT_SECONDS=180
# Official FreeCAD source revision. Use a full immutable Git commit SHA in production.
FREECAD_REF=main
FREECAD_BUILD_JOBS=2
API_CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# LangSmith tracing + evals. Leave LANGSMITH_TRACING=false (or the key blank)
# to keep the worker fully offline; both must be set for traces to be sent.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cadpilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
