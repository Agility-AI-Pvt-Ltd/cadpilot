CAD_STORAGE_ROOT=/data/storage
DATABASE_URL=postgresql+psycopg://cadpilot:cadpilot@postgres:5432/cadpilot
POSTGRES_PASSWORD=cadpilot
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
# The worker image includes this server; it invokes official FreeCAD's freecadcmd.
MCP_SERVER_COMMAND=freecad-mcp
MCP_SERVER_ARGS=--only-text-feedback --freecadcmd /usr/local/bin/freecadcmd
MCP_TIMEOUT_SECONDS=180
# Official FreeCAD source revision. Use a full immutable Git commit SHA in production.
FREECAD_REF=main
FREECAD_BUILD_JOBS=2
# The demo gateway serves frontend and API from the same HTTP origin.
API_CORS_ORIGINS=http://localhost
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Point at any OpenAI-compatible provider that implements the Responses API
# instead of OpenAI directly, e.g. OpenRouter: use your OpenRouter key as
# OPENAI_API_KEY above, set OPENAI_BASE_URL=https://openrouter.ai/api/v1,
# and give OPENAI_MODEL that provider's model id (e.g. openai/gpt-4.1-mini).
# Leave blank to use OpenAI's own endpoint.
OPENAI_BASE_URL=
# LangSmith tracing + evals. Leave LANGSMITH_TRACING=false (or the key blank)
# to keep the worker fully offline; both must be set for traces to be sent.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cadpilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
